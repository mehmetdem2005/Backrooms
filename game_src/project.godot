; Engine configuration file.
; Godot 4.6.3 - Mobile renderer, ust seviye telefon hedefi.
; V3 PREMIUM: hatalar tarandi/duzeltildi, kaliteli karanlik + fener, gelismis AI,
; yeni sesler + jumpscare, harita BFS ile garanti ulasilabilir cikis.

config_version=5

[application]
config/name="Backrooms Premium Mobile V3"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon=""

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]
3d/physics_engine="GodotPhysics3D"
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=4
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
scaling_3d/mode=0
scaling_3d/scale=0.75
environment/glow/upscale_mode=1
environment/defaults/default_clear_color=Color(0.01, 0.009, 0.006, 1)
